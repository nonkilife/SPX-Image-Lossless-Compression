# SPX Whitelist .gitignore
# Exclude everything
*

# Whitelist directories
!core/
!core/**
!technical/
!technical/**
!native/
!native/**

# Whitelist files
!README.md
!main.py
!LICENSE
!test.bat
!.gitignore

# Re-exclude Python junk
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.claude/
.venv/
.env

# Re-exclude Rust junk (except what's needed for build)
native/target/

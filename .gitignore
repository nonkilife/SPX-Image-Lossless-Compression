# ZPNG Whitelist .gitignore
# Exclude everything
*

# Whitelist directories
!core/
!core/**
!technical/
!technical/**

# Whitelist files
!README.md
!main.py
!LICENSE.txt
!test.bat
!.gitignore

# Re-exclude Python junk
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.pytest_cache/
.claude/
.venv/
.env

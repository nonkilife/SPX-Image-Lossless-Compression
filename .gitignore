# SPX Whitelist .gitignore
# Exclude everything
*

# Whitelist directories
!.github/
!.github/**
!spx/
!spx/**
!technical/
!technical/**
!native/
!native/**
!dist/
!dist/spx.exe
!dist/INSTRUCTIONS.md

# Whitelist files
!README.md
!README_zh-TW.md
!main.py
!LICENSE
!test.bat
!.gitignore
!pyproject.toml
!spx.spec
!native/Cargo.lock

# Re-exclude junk
__pycache__/
*.py[cod]
.pytest_cache/
.claude/
.venv/
native/target/
spx/*.pyd
spx/*.so
spx/*.pdb
